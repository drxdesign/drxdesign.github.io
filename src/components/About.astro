---
const skills = [
  { name: 'HTML / CSS',     pct: 95 },
  { name: 'JavaScript',     pct: 90 },
  { name: 'Tailwind CSS',   pct: 95 },
  { name: 'Astro.js',       pct: 85 },
  { name: 'UI / UX Design', pct: 90 },
];

const pillars = [
  {
    title: 'Clean Code',
    desc: 'I write scalable and maintainable code.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
  },
  {
    title: 'Modern Design',
    desc: 'I design visually appealing and user-friendly interfaces.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>`,
  },
  {
    title: 'Performance',
    desc: 'I build fast and optimized web experiences.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>`,
  },
];
---

<section id="about" aria-labelledby="about-heading" class="py-20 px-6 md:px-16">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-14 items-start">

    <!-- Left -------------------------------------------------- -->
    <div>
      <!-- Section label is decorative, the h2 is the real heading -->
      <p class="reveal section-label mb-3" aria-hidden="true">About Me</p>

      <h2 id="about-heading" class="reveal delay-100 text-3xl md:text-4xl font-bold leading-snug mb-5">
        I'm a passionate developer who loves
        <span class="text-accent">clean design</span> and
        <span class="text-accent">efficient code.</span>
      </h2>

      <p class="reveal delay-200 text-gray-400 text-sm leading-relaxed mb-10 max-w-sm">
        With a strong eye for design and a love for development, I create websites
        that are not only beautiful but also fast, responsive and user-friendly.
      </p>

      <!-- Pillars -->
      <ul class="reveal delay-300 grid grid-cols-3 gap-5 list-none p-0" role="list">
        {pillars.map(({ title, desc, icon }) => (
          <li>
            <div class="text-accent mb-2" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                aria-hidden="true" focusable="false" set:html={icon} />
            </div>
            <!-- h3 correctly follows h2 in this section -->
            <h3 class="text-white font-semibold text-sm mb-1">{title}</h3>
            <p class="text-gray-500 text-xs leading-relaxed">{desc}</p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right: Skills card ------------------------------------ -->
    <div class="reveal-right bg-card border border-border rounded-2xl p-8">
      <!-- h3 correctly follows h2 -->
      <h3 class="text-white font-semibold text-lg mb-7">Skills</h3>

      <ul class="space-y-5 list-none p-0" id="skillBars" role="list">
        {skills.map(({ name, pct }) => (
          <li>
            <div class="flex justify-between text-sm mb-1.5">
              <span class="text-gray-300 font-medium" id={`skill-${name.replace(/\s|\//g, '-').toLowerCase()}`}>
                {name}
              </span>
              <span class="text-accent font-semibold" aria-hidden="true">{pct}%</span>
            </div>
            <div
              class="h-1 bg-border rounded-full overflow-hidden"
              role="progressbar"
              aria-valuenow={pct}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-labelledby={`skill-${name.replace(/\s|\//g, '-').toLowerCase()}`}
              aria-label={`${name}: ${pct}%`}
            >
              <div class="skill-bar-fill" data-pct={pct}></div>
            </div>
          </li>
        ))}
      </ul>

      <a
        href="#contact"
        class="btn-outline mt-8 w-full flex items-center justify-center gap-2 py-3.5 text-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        More About Me
      </a>
    </div>
  </div>
</section>

<script>
  const skillSection = document.getElementById('skillBars');
  if (skillSection) {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            document.querySelectorAll<HTMLElement>('.skill-bar-fill').forEach(bar => {
              bar.style.width = `${bar.dataset.pct}%`;
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(skillSection);
  }
</script>
