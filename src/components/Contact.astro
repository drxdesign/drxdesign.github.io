---
const contactInfo = [
  {
    label: "drx-design@hotmail.com",
    icon: `<path stroke-linecap="round" stroke-linejoin="round"
      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  },
  {
    label: "+213 774 834 829",
    icon: `<path stroke-linecap="round" stroke-linejoin="round"
      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
  },
  {
    label: "Available worldwide",
    icon: `<path stroke-linecap="round" stroke-linejoin="round"
      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  },
];
---

<section id="contact" class="py-20 px-6 md:px-16">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">
    <!-- Left info -->
    <div>
      <p class="reveal section-label mb-3">Contact Me</p>
      <h2
        class="reveal delay-100 text-3xl md:text-4xl font-bold leading-tight mb-4"
      >
        Let's work together
      </h2>
      <p class="reveal delay-200 text-gray-400 text-sm leading-relaxed mb-10">
        Have a project in mind or just want to say hello?<br />
        Feel free to reach out to me.
      </p>

      <div class="reveal delay-300 space-y-5">
        {
          contactInfo.map(({ label, icon }) => (
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-card border border-border flex items-center justify-center text-accent flex-shrink-0">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  set:html={icon}
                />
              </div>
              <span class="text-gray-300 text-sm">{label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Right form -->
    <div class="reveal-right">
      <form id="contactForm" class="space-y-4" novalidate>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <input
              type="text"
              name="name"
              placeholder="Name"
              class="form-input"
              required
              minlength="2"
            />
          </div>
          <div>
            <input
              type="email"
              name="email"
              placeholder="Email"
              class="form-input"
              required
            />
          </div>
        </div>

        <input
          type="text"
          name="subject"
          placeholder="Subject"
          class="form-input"
          required
        />

        <textarea
          name="message"
          placeholder="Message"
          rows="5"
          class="form-input resize-none"
          required
          minlength="10"></textarea>

        <button
          type="submit"
          id="submitBtn"
          class="btn-primary w-full py-4 text-sm flex items-center justify-center gap-2"
        >
          <span id="btnText">Send Message</span>
          <svg
            id="btnIcon"
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
        </button>

        <!-- Success / error message -->
        <div
          id="formStatus"
          class="hidden text-center text-sm py-3 rounded-xl font-medium"
        >
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const btnText = document.getElementById("btnText")!;
  const btnIcon = document.getElementById("btnIcon")!;
  const status = document.getElementById("formStatus")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    btnText.textContent = "Sending...";

    try {
      const response = await fetch("https://formspree.io/f/mgobygrr", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });

      if (response.ok) {
        status.textContent = "Message sent! I will get back to you soon.";
        status.classList.remove(
          "hidden",
          "bg-red-500/10",
          "text-red-400",
          "border-red-500/20",
        );
        status.classList.add(
          "bg-accent/10",
          "text-accent",
          "border",
          "border-accent/20",
        );
        form.reset();
      } else {
        throw new Error("Failed");
      }
    } catch {
      status.textContent =
        "Something went wrong. Please email me directly at drx-design@hotmail.com";
      status.classList.remove(
        "hidden",
        "bg-accent/10",
        "text-accent",
        "border-accent/20",
      );
      status.classList.add(
        "bg-red-500/10",
        "text-red-400",
        "border",
        "border-red-500/20",
      );
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = "Send Message";
      status.classList.remove("hidden");
      setTimeout(() => status.classList.add("hidden"), 6000);
    }
  });
</script>
