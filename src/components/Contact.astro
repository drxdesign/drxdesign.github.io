---
const contactItems = [
  {
    label: 'Send an email',
    value: 'drx-design@hotmail.com',
    href: 'mailto:drx-design@hotmail.com',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  },
  {
    label: 'Call me',
    value: '+1 234 567 890',
    href: 'tel:+12345678900',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
  },
  {
    label: 'Location',
    value: 'Available worldwide',
    href: null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>`,
  },
];
---

<section id="contact" aria-labelledby="contact-heading" class="py-24 px-6 md:px-8">
  <div class="max-w-6xl mx-auto">

    <!-- Section header -->
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="section-label">Contact</span>
      <div class="flex-1 h-px bg-gradient-to-r from-[#1A1A1A] to-transparent" aria-hidden="true"></div>
      <span class="num-label">03</span>
    </div>

    <div class="grid md:grid-cols-5 gap-12 md:gap-16">

      <!-- Left — 2 cols -->
      <div class="md:col-span-2">
        <h2 id="contact-heading" class="reveal delay-100 font-bold leading-tight mb-4"
            style="font-size: clamp(1.8rem, 4vw, 2.8rem);">
          Let's build something great together.
        </h2>
        <p class="reveal delay-200 text-[#A0A0A0] text-sm leading-relaxed mb-10">
          Have a project in mind or just want to say hello? I'm always open to new collaborations.
        </p>

        <!-- Contact items -->
        <ul class="reveal delay-300 space-y-3 list-none p-0" role="list">
          {contactItems.map(({ label, value, href, icon }) => (
            <li>
              {href ? (
                <a href={href} class="contact-item group">
                  <div class="contact-item-icon">
                    <svg class="w-[17px] h-[17px]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false" set:html={icon} />
                  </div>
                  <div>
                    <div class="text-[11px] text-[#5A5A5A] mb-0.5 font-medium">{label}</div>
                    <div class="text-[#F2F2F2] text-sm font-medium group-hover:text-accent transition-colors">
                      {value}
                    </div>
                  </div>
                </a>
              ) : (
                <div class="contact-item">
                  <div class="contact-item-icon">
                    <svg class="w-[17px] h-[17px]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false" set:html={icon} />
                  </div>
                  <div>
                    <div class="text-[11px] text-[#5A5A5A] mb-0.5 font-medium">{label}</div>
                    <div class="text-[#F2F2F2] text-sm font-medium">{value}</div>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right — 3 cols — Form -->
      <div class="md:col-span-3 reveal-right">
        <div class="bg-[#0F0F0F] border border-[#1A1A1A] rounded-2xl p-7 md:p-8">
          <form
            id="contactForm"
            aria-label="Send me a message"
            novalidate
          >
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div>
                <label for="name" class="block text-[11px] text-[#5A5A5A] font-medium mb-2 uppercase tracking-wide">
                  Name <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Ziane Maamar"
                  class="form-input"
                  required
                  minlength="2"
                  autocomplete="name"
                />
              </div>
              <div>
                <label for="email" class="block text-[11px] text-[#5A5A5A] font-medium mb-2 uppercase tracking-wide">
                  Email <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="you@email.com"
                  class="form-input"
                  required
                  autocomplete="email"
                />
              </div>
            </div>

            <div class="mb-4">
              <label for="subject" class="block text-[11px] text-[#5A5A5A] font-medium mb-2 uppercase tracking-wide">
                Subject <span class="text-accent" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                placeholder="Project inquiry, collaboration..."
                class="form-input"
                required
              />
            </div>

            <div class="mb-6">
              <label for="message" class="block text-[11px] text-[#5A5A5A] font-medium mb-2 uppercase tracking-wide">
                Message <span class="text-accent" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                placeholder="Tell me about your project..."
                rows="5"
                class="form-input resize-none"
                required
                minlength="10"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submitBtn"
              class="btn-primary w-full justify-center py-4 text-sm"
              aria-live="polite"
            >
              <span id="btnText">Send Message</span>
              <svg
                id="btnIcon"
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
            </button>

            <div
              id="formStatus"
              class="hidden mt-4 text-center text-sm py-3.5 px-4 rounded-xl font-medium"
              role="status"
              aria-live="polite"
              aria-atomic="true"
            ></div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form      = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnText   = document.getElementById('btnText')!;
  const btnIcon   = document.getElementById('btnIcon')!;
  const status    = document.getElementById('formStatus')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    submitBtn.disabled = true;
    btnText.textContent = 'Sending...';
    btnIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>`;

    try {
      const res = await fetch('https://formspree.io/f/YOUR_FORM_ID', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      if (!res.ok) throw new Error();

      status.textContent = "Message sent! I will get back to you within 24 hours.";
      status.className = "mt-4 text-center text-sm py-3.5 px-4 rounded-xl font-medium bg-accent/8 text-accent border border-accent/15";
      form.reset();
    } catch {
      status.textContent = "Something went wrong. Email me directly at drx-design@hotmail.com";
      status.className = "mt-4 text-center text-sm py-3.5 px-4 rounded-xl font-medium bg-red-500/8 text-red-400 border border-red-500/15";
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Send Message';
      btnIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>`;
      status.classList.remove('hidden');
      setTimeout(() => status.classList.add('hidden'), 7000);
    }
  });
</script>
