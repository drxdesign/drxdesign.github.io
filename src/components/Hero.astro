---
import SocialLinks from "./SocialLinks.astro";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-24 pb-16 px-6 md:px-16 overflow-hidden"
>
  <!-- Floating particles -->
  <div
    id="particles"
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <!-- Bottom fade -->
  <div
    class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-dark to-transparent pointer-events-none"
  >
  </div>

  <div
    class="max-w-6xl mx-auto w-full flex flex-col md:flex-row items-center justify-between gap-16"
  >
    <!-- ---- Left copy ---- -->
    <div class="flex-1 max-w-xl">
      <p class="reveal section-label mb-3">Hello, I'm</p>

      <h1
        class="reveal delay-100 text-5xl md:text-6xl font-bold leading-tight mb-2"
      >
        Web Designer &amp;<br />
        <span id="typingTarget" class="text-accent typing-cursor"></span>
      </h1>

      <p
        class="reveal delay-200 text-gray-400 text-base leading-relaxed mt-4 mb-8 max-w-sm"
      >
        I design and build modern, responsive websites that provide great user
        experiences and help businesses grow.
      </p>

      <!-- CTAs -->
      <div class="reveal delay-300 flex flex-wrap items-center gap-3 mb-8">
        <a
          href="#work"
          class="btn-primary flex items-center gap-2 px-6 py-3 text-sm"
        >
          View My Work
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="/cv.pdf"
          download
          class="btn-outline flex items-center gap-2 px-6 py-3 text-sm"
        >
          Download CV
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
        </a>
      </div>

      <div class="reveal delay-400">
        <SocialLinks />
      </div>
    </div>

    <!-- ---- Right photo ---- -->
    <div class="reveal-right relative flex flex-col items-center flex-shrink-0">
      <!-- Handwritten annotation -->
      <span
        class="annotation absolute -top-10 -right-2 flex items-center gap-1"
      >
        That's me!
        <svg
          class="w-7 h-7 mt-2"
          fill="none"
          stroke="#9FE45A"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </span>

      <!-- Glow circle + photo -->
      <div class="relative w-64 h-64 md:w-72 md:h-72 animate-float">
        <div class="hero-glow absolute inset-0 rounded-full"></div>
        <div
          class="absolute inset-0 rounded-full overflow-hidden bg-accent flex items-end justify-center"
        >
          <!-- Replace the SVG below with an <img> tag pointing to your real photo -->
          <img
            src="../public/profile.jpg"
            alt="Profile Photo"
            class="w-full h-full
          object-cover"
          />
        </div>
      </div>

      <!-- Available badge -->
      <div
        class="mt-6 bg-card border border-border rounded-2xl px-5 py-3 flex items-center gap-3 shadow-xl"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-accent animate-pulse"></span>
        <span class="text-sm font-medium text-gray-300">Available for work</span
        >
      </div>
    </div>
  </div>
</section>

<script>
  // ---- Typing effect ----
  const words = ["Developer", "Creator", "Builder"];
  const target = document.getElementById("typingTarget")!;
  let wi = 0,
    ci = 0,
    deleting = false;

  function type() {
    const word = words[wi];
    if (!deleting) {
      target.textContent = word.slice(0, ++ci);
      if (ci === word.length) {
        deleting = true;
        setTimeout(type, 1800);
        return;
      }
    } else {
      target.textContent = word.slice(0, --ci);
      if (ci === 0) {
        deleting = false;
        wi = (wi + 1) % words.length;
      }
    }
    setTimeout(type, deleting ? 60 : 90);
  }
  setTimeout(type, 800);

  // ---- Particles ----
  const container = document.getElementById("particles")!;
  for (let i = 0; i < 20; i++) {
    const p = document.createElement("div");
    p.classList.add("particle");
    const size = 2 + Math.random() * 3;
    Object.assign(p.style, {
      width: `${size}px`,
      height: `${size}px`,
      left: `${Math.random() * 100}%`,
      bottom: `${Math.random() * 40}%`,
      animationDuration: `${7 + Math.random() * 9}s`,
      animationDelay: `${Math.random() * 9}s`,
    });
    container.appendChild(p);
  }
</script>
