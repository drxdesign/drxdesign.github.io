---
import SocialLinks from './SocialLinks.astro';
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative min-h-screen flex items-center pt-28 pb-20 px-6 md:px-8 overflow-hidden grid-bg"
>
  <!-- Ambient glow — behind content -->
  <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] rounded-full pointer-events-none" aria-hidden="true"
       style="background: radial-gradient(circle, rgba(159,228,90,0.04) 0%, transparent 70%); transform: translate(-50%, -50%);"></div>

  <!-- Particles -->
  <div id="particles" class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-40 pointer-events-none" aria-hidden="true"
       style="background: linear-gradient(to top, #0C0C0C, transparent)"></div>

  <div class="max-w-6xl mx-auto w-full">
    <div class="flex flex-col md:flex-row items-center justify-between gap-12 md:gap-16">

      <!-- ---- Left ---- -->
      <div class="flex-1 max-w-2xl">

        <!-- Available badge -->
        <div class="reveal mb-8">
          <span class="avail-badge" role="status" aria-label="Currently available for new projects">
            <span class="avail-dot" aria-hidden="true"></span>
            Available for new projects
          </span>
        </div>

        <!-- Heading -->
        <h1 id="hero-heading" class="reveal delay-100 font-bold leading-[1.05] tracking-tight mb-6">
          <span class="block text-[#F2F2F2]" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
            Designing the web,
          </span>
          <span class="block" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
            one pixel at a time<span class="text-accent">.</span>
          </span>
        </h1>

        <!-- Role cycling -->
        <div class="reveal delay-200 flex items-center gap-3 mb-6">
          <span class="text-[#5A5A5A] text-sm font-mono">~/role</span>
          <span class="text-[#3A3A3A]">›</span>
          <span
            id="typingTarget"
            class="text-accent text-sm font-mono typing-cursor"
            aria-live="polite"
            aria-label="Web Developer"
          ></span>
        </div>

        <p class="reveal delay-300 text-[#A0A0A0] text-base leading-relaxed mb-10 max-w-md">
          I design and build modern, responsive websites that deliver
          exceptional user experiences and drive real business results.
        </p>

        <!-- CTAs -->
        <div class="reveal delay-400 flex flex-wrap items-center gap-3 mb-10">
          <a href="#work" class="btn-primary px-6 py-3 text-sm">
            View My Work
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#contact" class="btn-outline px-6 py-3 text-sm">
            Start a Project
          </a>
        </div>

        <!-- Social + divider -->
        <div class="reveal delay-500 flex items-center gap-5">
          <SocialLinks />
          <div class="h-4 w-px bg-[#1A1A1A]" aria-hidden="true"></div>
          <span class="text-[#3A3A3A] text-xs">drxdesign.github.io</span>
        </div>
      </div>

      <!-- ---- Right — photo + stats ---- -->
      <div class="relative flex flex-col items-center gap-5 flex-shrink-0">

        <!-- Annotation -->
        <span class="annotation absolute -top-8 right-4 z-10" aria-hidden="true">
          That's me!
        </span>

        <!-- Photo ring -->
        <div class="relative" style="animation: float 7s ease-in-out infinite;">
          <!-- Outer decorative ring -->
          <div
            class="absolute -inset-3 rounded-full"
            aria-hidden="true"
            style="border: 1px dashed rgba(159,228,90,0.2); animation: spinSlow 20s linear infinite;"
          ></div>
          <!-- Accent dot on ring -->
          <div
            class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-3 w-2 h-2 rounded-full bg-accent"
            aria-hidden="true"
          ></div>

          <!-- Photo -->
          <div class="relative w-56 h-56 md:w-64 md:h-64 rounded-full overflow-hidden">
            <div class="hero-glow absolute inset-0 rounded-full" aria-hidden="true"></div>
            <div class="absolute inset-0 rounded-full overflow-hidden bg-accent flex items-end justify-center">
              <!-- Replace with: <img src="/profile.jpg" alt="Ziane Maamar" width="256" height="256" class="w-full h-full object-cover object-top" loading="eager" fetchpriority="high" /> -->
              <svg viewBox="0 0 256 256" class="w-full h-full" style="mix-blend-mode:multiply;" aria-hidden="true" focusable="false">
                <circle cx="128" cy="100" r="46" fill="#111"/>
                <ellipse cx="128" cy="220" rx="72" ry="54" fill="#111"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Stats row -->
        <div class="flex gap-3 mt-2">
          <div class="stat-card text-center min-w-[88px]">
            <div class="text-2xl font-bold text-white leading-none">3+</div>
            <div class="text-[11px] text-[#5A5A5A] mt-1 leading-tight">Years<br/>Experience</div>
          </div>
          <div class="stat-card text-center min-w-[88px]">
            <div class="text-2xl font-bold text-white leading-none">20+</div>
            <div class="text-[11px] text-[#5A5A5A] mt-1 leading-tight">Projects<br/>Delivered</div>
          </div>
          <div class="stat-card text-center min-w-[88px]">
            <div class="text-2xl font-bold text-accent leading-none">100%</div>
            <div class="text-[11px] text-[#5A5A5A] mt-1 leading-tight">Client<br/>Satisfaction</div>
          </div>
        </div>
      </div>

    </div>

